# Competition data (large files, not versioned)
data/*.csv
data/*.zip
data/processed/

# Trained model artifacts / generated lookup tables
model/*.pkl
model/*.joblib
model/*.txt
model/*.cbm
model/*.csv
model/*.py
references/baseline_example/rf.pkl
output/*.csv
output/*.npy
output/*.npz
output/*.pkl

# Large derived mapping tables (regenerate via reports/trackman_id_mapping/run_mapping.py;
# code/docs/log are tracked, the multi-hundred-MB row-level CSVs are not)
reports/trackman_id_mapping/tables/row_mapping*.csv

# CatBoost auto-generated training logs (learn/test error history, not
# a model artifact itself, regenerated every run)
catboost_info/

# Submission packaging artifacts (rebuilt by src/package_submission.py
# before each submit; submission/submit.zip is also covered by the blanket
# *.zip rule below, kept explicit here for clarity). submission/features.py
# is a fresh copy of src/features.py made at packaging time (exp_002+) —
# src/features.py is the tracked source of truth, this copy is not.
submission/model/
submission/features.py

# submission/archive/<label>/ — keep script.py + requirements.txt tracked
# (this is the exact code that was actually submitted for that leaderboard
# entry, teammates need to be able to find it) but not the binary model
# artifacts or the zip, which follow the same rules as model/ above.
submission/archive/*/model/
submission/archive/*/submit.zip

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# Environments
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Archives
*.zip
